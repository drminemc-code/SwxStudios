rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isOwnerAdmin() {
      return isVerified() && request.auth.token.email in ['randellemupas@gmail.com', 'drminemc@gmail.com'];
    }

    function isTierAdmin() {
      return isVerified() && exists(/databases/$(database)/documents/tierAdmins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'xp', 'isPremium', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'avatarUrl', 'xp', 'isPremium', 'membershipTier', 'purchasedIds', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && data.xp is number && data.xp >= 0 && data.xp <= 1000000
        && data.isPremium is bool
        && (!('membershipTier' in data) || (data.membershipTier is string && data.membershipTier in ['free', 'premium', 'ultimate']))
        && (!('purchasedIds' in data) || (data.purchasedIds is list && data.purchasedIds.size() <= 200 && (data.purchasedIds.size() == 0 || (data.purchasedIds[0] is string && data.purchasedIds[0].size() <= 128))))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidConnection(data, providerId) {
      return data.keys().hasAll(['uid', 'provider', 'providerUserId', 'username', 'connectedAt'])
        && data.keys().hasOnly(['uid', 'provider', 'providerUserId', 'username', 'displayName', 'avatarUrl', 'profileUrl', 'connectedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.provider is string && data.provider == providerId
        && data.provider in ['google', 'discord', 'github', 'microsoft', 'twitch']
        && data.providerUserId is string && data.providerUserId.size() >= 1 && data.providerUserId.size() <= 128
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 100
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (!('profileUrl' in data) || (data.profileUrl is string && data.profileUrl.size() <= 500))
        && data.connectedAt is timestamp;
    }

    function isValidResourcePackage(data, resourceId) {
      return data.keys().hasAll([
          'id', 'title', 'subtitle', 'description', 'category',
          'downloads', 'rating', 'ratingCount', 'version', 'mcVersions',
          'fileSize', 'author', 'updatedAt', 'popular', 'exclusive',
          'tags', 'artwork', 'accentColor', 'features',
          'fileName', 'fileExtension', 'downloadUrl', 'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'subtitle', 'description', 'category',
          'downloads', 'views', 'rating', 'ratingCount', 'version', 'mcVersions',
          'fileSize', 'author', 'publishedAt', 'updatedAt', 'popular', 'exclusive',
          'tier', 'priceLabel',
          'openSource', 'drmFree', 'unobfuscated', 'aiMarketing', 'aiProduct',
          'resourceType', 'gameModes', 'supportedSoftware', 'supportedVersions',
          'supportedLanguages', 'dependencies', 'changelog', 'demoVideoUrl',
          'tags', 'artwork', 'accentColor', 'features',
          'fileName', 'fileExtension', 'downloadUrl', 'createdBy', 'createdAt'
        ])
        && data.id is string && data.id == resourceId && data.id.size() <= 128
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.subtitle is string && data.subtitle.size() >= 2 && data.subtitle.size() <= 160
        && data.description is string && data.description.size() >= 3 && data.description.size() <= 3000
        && data.category is string && data.category in ['plugins', 'configs', 'setups', 'models', 'maps', 'skripts', 'clients', 'bots', 'source']
        && data.downloads is number && data.downloads >= 0 && data.downloads <= 100000000
        && (!('views' in data) || (data.views is number && data.views >= 0 && data.views <= 1000000000))
        && data.rating is number && data.rating >= 0 && data.rating <= 10
        && data.ratingCount is number && data.ratingCount >= 0 && data.ratingCount <= 10000000
        && data.version is string && data.version.size() >= 1 && data.version.size() <= 40
        && data.mcVersions is string && data.mcVersions.size() >= 1 && data.mcVersions.size() <= 60
        && data.fileSize is string && data.fileSize.size() >= 1 && data.fileSize.size() <= 32
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 80
        && (!('publishedAt' in data) || (data.publishedAt is string && data.publishedAt.size() <= 40))
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 40
        && data.popular is bool
        && data.exclusive is bool
        && (!('tier' in data) || (data.tier is string && data.tier in ['free', 'paid', 'premium', 'ultimate']))
        && (!('priceLabel' in data) || (data.priceLabel is string && data.priceLabel.size() <= 24))
        && (!('openSource' in data) || data.openSource is bool)
        && (!('drmFree' in data) || data.drmFree is bool)
        && (!('unobfuscated' in data) || data.unobfuscated is bool)
        && (!('aiMarketing' in data) || data.aiMarketing is bool)
        && (!('aiProduct' in data) || data.aiProduct is bool)
        && (!('resourceType' in data) || (data.resourceType is string && data.resourceType.size() <= 40))
        && (!('gameModes' in data) || (data.gameModes is list && data.gameModes.size() <= 10 && (data.gameModes.size() == 0 || (data.gameModes[0] is string && data.gameModes[0].size() <= 40))))
        && (!('supportedSoftware' in data) || (data.supportedSoftware is list && data.supportedSoftware.size() <= 10 && (data.supportedSoftware.size() == 0 || (data.supportedSoftware[0] is string && data.supportedSoftware[0].size() <= 40))))
        && (!('supportedVersions' in data) || (data.supportedVersions is list && data.supportedVersions.size() <= 12 && (data.supportedVersions.size() == 0 || (data.supportedVersions[0] is string && data.supportedVersions[0].size() <= 32))))
        && (!('supportedLanguages' in data) || (data.supportedLanguages is list && data.supportedLanguages.size() <= 12 && (data.supportedLanguages.size() == 0 || (data.supportedLanguages[0] is string && data.supportedLanguages[0].size() <= 40))))
        && (!('dependencies' in data) || (data.dependencies is list && data.dependencies.size() <= 15 && (data.dependencies.size() == 0 || (data.dependencies[0] is string && data.dependencies[0].size() <= 80))))
        && (!('changelog' in data) || (data.changelog is list && data.changelog.size() <= 20 && (data.changelog.size() == 0 || data.changelog[0] is map)))
        && (!('demoVideoUrl' in data) || (data.demoVideoUrl is string && data.demoVideoUrl.size() <= 500))
        && data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        && data.artwork is string && data.artwork.size() >= 1 && data.artwork.size() <= 40
        && data.accentColor is string && data.accentColor.size() >= 4 && data.accentColor.size() <= 20
        && data.features is list && data.features.size() <= 10 && (data.features.size() == 0 || (data.features[0] is string && data.features[0].size() <= 160))
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
        && data.fileExtension is string && data.fileExtension in ['jar', 'zip', 'rar', '7z', 'gz', 'tar']
        && data.downloadUrl is string && data.downloadUrl.size() >= 1 && data.downloadUrl.size() <= 500
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['announcementVisible', 'announcementLabel', 'announcementText', 'communityEnabled', 'updatedAt'])
        && data.keys().hasOnly([
          'announcementVisible', 'announcementLabel', 'announcementText',
          'communityEnabled', 'heroHeadline',
          'gcashNumber', 'gcashName', 'paypalEmail', 'paypalLink',
          'updatedBy', 'updatedAt'
        ])
        && data.announcementVisible is bool
        && data.announcementLabel is string && data.announcementLabel.size() <= 60
        && data.announcementText is string && data.announcementText.size() <= 240
        && data.communityEnabled is bool
        && (!('heroHeadline' in data) || (data.heroHeadline is string && data.heroHeadline.size() <= 120))
        && (!('gcashNumber' in data) || (data.gcashNumber is string && data.gcashNumber.size() <= 32))
        && (!('gcashName' in data) || (data.gcashName is string && data.gcashName.size() <= 80))
        && (!('paypalEmail' in data) || (data.paypalEmail is string && data.paypalEmail.size() <= 120))
        && (!('paypalLink' in data) || (data.paypalLink is string && data.paypalLink.size() <= 240))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && data.updatedAt is timestamp;
    }

    function isValidMembershipOrder(data, orderId) {
      return data.keys().hasAll([
          'id', 'userId', 'buyerName', 'plan', 'paymentMethod',
          'referenceCode', 'senderAccount', 'amountLabel', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'buyerName', 'plan', 'resourceId', 'resourceTitle',
          'paymentMethod', 'referenceCode', 'senderAccount', 'amountLabel',
          'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == orderId && data.id.size() >= 1 && data.id.size() <= 128
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 80
        && data.plan is string && data.plan in ['premium', 'ultimate', 'package']
        && (!('resourceId' in data) || (data.resourceId is string && data.resourceId.size() <= 128))
        && (!('resourceTitle' in data) || (data.resourceTitle is string && data.resourceTitle.size() <= 100))
        && data.paymentMethod is string && data.paymentMethod in ['gcash', 'paypal']
        && data.referenceCode is string && data.referenceCode.size() >= 4 && data.referenceCode.size() <= 64
        && data.senderAccount is string && data.senderAccount.size() >= 2 && data.senderAccount.size() <= 100
        && data.amountLabel is string && data.amountLabel.size() >= 1 && data.amountLabel.size() <= 32
        && data.status is string && data.status in ['pending', 'approved', 'declined']
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidServerListing(data, serverId) {
      return data.keys().hasAll(['id', 'name', 'address', 'edition', 'version', 'motd', 'gameModes', 'approved', 'featured', 'votes', 'submittedBy', 'submittedByName', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'name', 'address', 'edition', 'version', 'motd',
          'description', 'bedrockAddress', 'tps', 'mspt', 'pingMs', 'topPlayers',
          'gameModes', 'approved', 'featured', 'votes', 'submittedBy', 'submittedByName', 'createdAt'
        ])
        && data.id is string && data.id == serverId && data.id.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 120
        && data.edition is string && data.edition in ['Java', 'Bedrock', 'Crossplay']
        && data.version is string && data.version.size() >= 1 && data.version.size() <= 40
        && data.motd is string && data.motd.size() >= 1 && data.motd.size() <= 240
        && (!('description' in data) || (data.description is string && data.description.size() <= 1500))
        && (!('bedrockAddress' in data) || (data.bedrockAddress is string && data.bedrockAddress.size() <= 120))
        && (!('tps' in data) || (data.tps is number && data.tps >= 0 && data.tps <= 25))
        && (!('mspt' in data) || (data.mspt is number && data.mspt >= 0 && data.mspt <= 5000))
        && (!('pingMs' in data) || (data.pingMs is number && data.pingMs >= 0 && data.pingMs <= 10000))
        && (!('topPlayers' in data) || (data.topPlayers is list && data.topPlayers.size() <= 15 && (data.topPlayers.size() == 0 || (data.topPlayers[0] is string && data.topPlayers[0].size() <= 64))))
        && data.gameModes is list && data.gameModes.size() <= 8 && (data.gameModes.size() == 0 || (data.gameModes[0] is string && data.gameModes[0].size() <= 32))
        && data.approved is bool
        && data.featured is bool
        && data.votes is number && data.votes >= 0 && data.votes <= 10000000
        && data.submittedBy is string && data.submittedBy.size() >= 1 && data.submittedBy.size() <= 128
        && data.submittedByName is string && data.submittedByName.size() >= 1 && data.submittedByName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidThread(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'authorRole', 'title', 'topic', 'body', 'upvotes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authorId', 'authorName', 'authorRole', 'title', 'topic', 'body', 'upvotes', 'createdAt', 'updatedAt'])
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorRole is string && data.authorRole.size() >= 1 && data.authorRole.size() <= 40
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.topic is string && data.topic in ['Plugins Help', 'Server Setups', 'Showcase', 'Requests']
        && data.body is string && data.body.size() >= 3 && data.body.size() <= 3000
        && data.upvotes is number && data.upvotes >= 0 && data.upvotes <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReply(data, threadId) {
      return data.keys().hasAll(['threadId', 'authorId', 'authorName', 'authorRole', 'content', 'createdAt'])
        && data.keys().hasOnly(['threadId', 'authorId', 'authorName', 'authorRole', 'content', 'createdAt'])
        && data.threadId is string && data.threadId == threadId && data.threadId.size() <= 128
        && data.authorId is string && data.authorId == request.auth.uid && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorRole is string && data.authorRole.size() >= 1 && data.authorRole.size() <= 40
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidTierRankStr(val) {
      return val is string && val in ['HT1', 'LT1', 'HT2', 'LT2', 'HT3', 'LT3', 'HT4', 'LT4', 'HT5', 'LT5'];
    }

    function isValidTierRanksMap(m) {
      return m is map
        && m.keys().hasOnly(['vanilla', 'uhc', 'pot', 'nethop', 'smp', 'sword', 'axe', 'mace'])
        && (!('vanilla' in m) || isValidTierRankStr(m.vanilla))
        && (!('uhc' in m) || isValidTierRankStr(m.uhc))
        && (!('pot' in m) || isValidTierRankStr(m.pot))
        && (!('nethop' in m) || isValidTierRankStr(m.nethop))
        && (!('smp' in m) || isValidTierRankStr(m.smp))
        && (!('sword' in m) || isValidTierRankStr(m.sword))
        && (!('axe' in m) || isValidTierRankStr(m.axe))
        && (!('mace' in m) || isValidTierRankStr(m.mace));
    }

    function isValidTierPlayer(data, playerId) {
      return data.keys().hasAll([
          'id', 'ign', 'region', 'ranks', 'points',
          'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ign', 'region', 'ranks', 'peakRanks', 'points',
          'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == playerId && data.id.size() >= 1 && data.id.size() <= 128
        && data.ign is string && data.ign.size() >= 2 && data.ign.size() <= 24 && data.ign.matches('^[a-zA-Z0-9_]+$')
        && data.region is string && data.region in ['NA', 'EU', 'AS', 'OCE', 'SA']
        && isValidTierRanksMap(data.ranks)
        && (!('peakRanks' in data) || isValidTierRanksMap(data.peakRanks))
        && data.points is number && data.points >= 0 && data.points <= 1000
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTierAdmin(data, adminUid) {
      return data.keys().hasAll(['uid', 'displayName', 'grantedBy', 'grantedByName', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'grantedBy', 'grantedByName', 'createdAt'])
        && data.uid is string && data.uid == adminUid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.grantedBy is string && data.grantedBy == request.auth.uid && data.grantedBy.size() <= 128
        && data.grantedByName is string && data.grantedByName.size() >= 1 && data.grantedByName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidTierCommandLog(data, commandId) {
      return data.keys().hasAll([
          'id', 'commandText', 'action', 'executorUid',
          'executorName', 'executorRole', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'commandText', 'action', 'executorUid',
          'executorName', 'executorRole', 'summary', 'createdAt'
        ])
        && data.id is string && data.id == commandId && data.id.size() >= 1 && data.id.size() <= 128
        && data.commandText is string && data.commandText.size() >= 1 && data.commandText.size() <= 240
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 40
        && data.executorUid is string && data.executorUid == request.auth.uid && data.executorUid.size() <= 128
        && data.executorName is string && data.executorName.size() >= 1 && data.executorName.size() <= 80
        && data.executorRole is string && data.executorRole in ['owner', 'admin']
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 200
        && data.createdAt is timestamp;
    }

    function isValidSiteMetrics(data) {
      return data.keys().hasAll(['visits', 'updatedAt'])
        && data.keys().hasOnly(['visits', 'updatedAt'])
        && data.visits is number && data.visits >= 0 && data.visits <= 1000000000
        && data.updatedAt is timestamp;
    }

    function isValidServerRank(val) {
      return val is string && val in ['owner', 'admin', 'staff', 'support', 'member', 'ultimate', 'paid', 'free'];
    }

    function isValidPresenceStatus(val) {
      return val is string && val in ['online', 'away', 'offline'];
    }

    function isValidPublicMember(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'membershipTier', 'xp', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'avatarUrl', 'role', 'serverRank', 'serverRoles', 'membershipTier', 'presenceStatus', 'xp', 'joinedAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && data.role is string && data.role in ['member', 'admin', 'owner']
        && (!('serverRank' in data) || isValidServerRank(data.serverRank))
        && (!('serverRoles' in data) || (
          data.serverRoles is list
          && data.serverRoles.size() <= 8
          && (data.serverRoles.size() == 0 || (isValidServerRank(data.serverRoles[0]) && data.serverRoles.hasOnly(['owner', 'admin', 'staff', 'support', 'member', 'ultimate', 'paid', 'free'])))
        ))
        && data.membershipTier is string && data.membershipTier in ['free', 'premium', 'ultimate']
        && (!('presenceStatus' in data) || isValidPresenceStatus(data.presenceStatus))
        && data.xp is number && data.xp >= 0 && data.xp <= 1000000
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFriendship(data, friendshipId) {
      return data.keys().hasAll(['id', 'users', 'requesterUid', 'requesterName', 'recipientUid', 'recipientName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'users', 'requesterUid', 'requesterName', 'requesterAvatar', 'recipientUid', 'recipientName', 'recipientAvatar', 'status', 'blockedBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == friendshipId && data.id.size() >= 3 && data.id.size() <= 128
        && data.users is list
        && data.users.size() == 2
        && data.users[0] is string && data.users[0].size() >= 1 && data.users[0].size() <= 128
        && data.users[1] is string && data.users[1].size() >= 1 && data.users[1].size() <= 128
        && data.users[0] != data.users[1]
        && data.requesterUid is string && data.requesterUid.size() >= 1 && data.requesterUid.size() <= 128 && data.requesterUid in data.users
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 80
        && (!('requesterAvatar' in data) || (data.requesterAvatar is string && data.requesterAvatar.size() <= 500))
        && data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid.size() <= 128 && data.recipientUid in data.users && data.recipientUid != data.requesterUid
        && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 80
        && (!('recipientAvatar' in data) || (data.recipientAvatar is string && data.recipientAvatar.size() <= 500))
        && data.status is string && data.status in ['pending', 'accepted', 'declined', 'blocked']
        && (!('blockedBy' in data) || (data.blockedBy is string && data.blockedBy.size() >= 1 && data.blockedBy.size() <= 128 && data.blockedBy in data.users))
        && (data.status != 'blocked' || ('blockedBy' in data && data.blockedBy in data.users))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlayerSuggestion(data, suggestionId) {
      return data.keys().hasAll(['id', 'ign', 'suggestedBy', 'suggestedByName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ign', 'suggestedRank', 'suggestedMode', 'note', 'suggestedBy', 'suggestedByName', 'status', 'reviewedBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == suggestionId && data.id.size() >= 1 && data.id.size() <= 128
        && data.ign is string && data.ign.size() >= 2 && data.ign.size() <= 24 && data.ign.matches('^[a-zA-Z0-9_]+$')
        && (!('suggestedRank' in data) || isValidServerRank(data.suggestedRank))
        && (!('suggestedMode' in data) || (data.suggestedMode is string && data.suggestedMode.size() <= 24))
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.suggestedBy is string && data.suggestedBy.size() >= 1 && data.suggestedBy.size() <= 128
        && data.suggestedByName is string && data.suggestedByName.size() >= 1 && data.suggestedByName.size() <= 80
        && data.status is string && data.status in ['pending', 'approved', 'declined']
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User profile (owner-only, non-PII; membership elevation restricted to Studio Owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isOwnerAdmin());
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && (
          isOwnerAdmin() || (
            incoming().isPremium == false
            && (!('membershipTier' in incoming()) || incoming().membershipTier == 'free')
            && (!('purchasedIds' in incoming()) || incoming().purchasedIds.size() == 0)
          )
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'xp', 'updatedAt'])
          ) || (
            isOwnerAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['isPremium', 'membershipTier', 'purchasedIds', 'updatedAt'])
          )
        );
      allow delete: if false;

      // Isolated Private PII
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'info' && isOwner(userId);
        allow list: if false;
        allow create, update: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidPrivateInfo(incoming())
          && incoming().updatedAt == request.time;
        allow delete: if false;
      }

      // Linked OAuth Accounts
      match /connections/{providerId} {
        allow get: if isValidId(userId) && isValidId(providerId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId)
          && isValidId(providerId)
          && isOwner(userId)
          && isValidConnection(incoming(), providerId)
          && incoming().connectedAt == request.time;
        allow delete: if isValidId(userId) && isValidId(providerId) && isOwner(userId);
      }
    }

    // Owner-Managed Published Resources Catalog
    match /resources/{resourceId} {
      allow get: if isValidId(resourceId);
      allow list: if true;
      allow create: if isValidId(resourceId)
        && isOwnerAdmin()
        && isValidResourcePackage(incoming(), resourceId)
        && incoming().createdBy == request.auth.uid
        && incoming().downloads == 0
        && incoming().createdAt == request.time;
      allow update: if isValidId(resourceId)
        && isValidResourcePackage(incoming(), resourceId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (
          (
            isOwnerAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'subtitle', 'description', 'category', 'version',
              'mcVersions', 'fileSize', 'author', 'publishedAt', 'updatedAt', 'popular',
              'exclusive', 'tier', 'priceLabel',
              'openSource', 'drmFree', 'unobfuscated', 'aiMarketing', 'aiProduct',
              'resourceType', 'gameModes', 'supportedSoftware', 'supportedVersions',
              'supportedLanguages', 'dependencies', 'changelog', 'demoVideoUrl',
              'tags', 'artwork', 'accentColor', 'features', 'fileName', 'fileExtension', 'downloadUrl'
            ])
          ) || (
            incoming().diff(existing()).affectedKeys().hasOnly(['downloads'])
            && incoming().downloads == existing().downloads + 1
          ) || (
            incoming().diff(existing()).affectedKeys().hasOnly(['views'])
            && ((!('views' in existing()) && incoming().views == 1) || ('views' in existing() && incoming().views == existing().views + 1))
          ) || (
            isVerified()
            && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'ratingCount'])
            && incoming().ratingCount == existing().ratingCount + 1
          )
        );
      allow delete: if isValidId(resourceId) && isOwnerAdmin();
    }

    // Community Threads
    match /threads/{threadId} {
      allow get: if isValidId(threadId);
      allow list: if true;
      allow create: if isValidId(threadId)
        && isVerified()
        && isValidThread(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().upvotes == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(threadId)
        && isVerified()
        && isValidThread(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'topic', 'updatedAt'])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'updatedAt']) && (incoming().upvotes == existing().upvotes + 1 || incoming().upvotes == existing().upvotes - 1))
        );
      allow delete: if isValidId(threadId) && ((isVerified() && existing().authorId == request.auth.uid) || isOwnerAdmin());

      match /replies/{replyId} {
        allow get: if isValidId(threadId) && isValidId(replyId);
        allow list: if isValidId(threadId);
        allow create: if isValidId(threadId)
          && isValidId(replyId)
          && isVerified()
          && exists(/databases/$(database)/documents/threads/$(threadId))
          && isValidReply(incoming(), threadId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(threadId) && isValidId(replyId) && ((isVerified() && existing().authorId == request.auth.uid) || isOwnerAdmin());
      }
    }

    // Owner-Managed Global Site Settings
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'site';
      allow list: if false;
      allow create, update: if isValidId(settingId)
        && settingId == 'site'
        && isOwnerAdmin()
        && isValidSiteSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Minecraft Server Directory Listings
    match /servers/{serverId} {
      allow get: if isValidId(serverId) && (existing().approved == true || isOwnerAdmin() || (isVerified() && existing().submittedBy == request.auth.uid));
      allow list: if existing().approved == true || isOwnerAdmin();
      allow create: if isValidId(serverId)
        && isVerified()
        && isValidServerListing(incoming(), serverId)
        && incoming().submittedBy == request.auth.uid
        && incoming().votes == 0
        && (isOwnerAdmin() || (incoming().approved == false && incoming().featured == false))
        && incoming().createdAt == request.time;
      allow update: if isValidId(serverId)
        && isValidServerListing(incoming(), serverId)
        && incoming().id == existing().id
        && incoming().submittedBy == existing().submittedBy
        && incoming().createdAt == existing().createdAt
        && (
          (isOwnerAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'address', 'edition', 'version', 'motd', 'description',
            'bedrockAddress', 'tps', 'mspt', 'pingMs', 'topPlayers', 'gameModes',
            'approved', 'featured'
          ])) ||
          (isVerified() && existing().submittedBy == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'address', 'edition', 'version', 'motd', 'description',
            'bedrockAddress', 'tps', 'mspt', 'pingMs', 'topPlayers', 'gameModes'
          ])) ||
          (isVerified() && existing().approved == true && incoming().diff(existing()).affectedKeys().hasOnly(['votes']) && incoming().votes == existing().votes + 1)
        );
      allow delete: if isValidId(serverId) && (isOwnerAdmin() || (isVerified() && existing().submittedBy == request.auth.uid));
    }

    // GCash & PayPal Membership Purchase Orders
    match /membershipOrders/{orderId} {
      allow get: if isValidId(orderId) && (isOwnerAdmin() || (isVerified() && existing().userId == request.auth.uid));
      allow list: if isOwnerAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId)
        && isVerified()
        && isValidMembershipOrder(incoming(), orderId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId)
        && isOwnerAdmin()
        && isValidMembershipOrder(incoming(), orderId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if isValidId(orderId) && isOwnerAdmin();
    }

    // Competitive PvP Tier List Players
    match /tierPlayers/{playerId} {
      allow get: if isValidId(playerId);
      allow list: if true;
      allow create: if isValidId(playerId)
        && (isOwnerAdmin() || isTierAdmin())
        && isValidTierPlayer(incoming(), playerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(playerId)
        && (isOwnerAdmin() || isTierAdmin())
        && isValidTierPlayer(incoming(), playerId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'ign', 'region', 'ranks', 'peakRanks', 'points',
          'updatedBy', 'updatedByName', 'updatedAt'
        ]);
      allow delete: if isValidId(playerId) && (isOwnerAdmin() || isTierAdmin());
    }

    // Owner-Assigned Tier List Administrators (keyed by Firebase UID)
    match /tierAdmins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwnerAdmin() || (isVerified() && request.auth.uid == adminUid));
      allow list: if isOwnerAdmin();
      allow create: if isValidId(adminUid)
        && isOwnerAdmin()
        && isValidTierAdmin(incoming(), adminUid)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminUid) && isOwnerAdmin();
    }

    // Owner & Tier Admin Command Execution Audit Log
    match /tierCommands/{commandId} {
      allow get, list: if isOwnerAdmin() || isTierAdmin();
      allow create: if isValidId(commandId)
        && (isOwnerAdmin() || isTierAdmin())
        && isValidTierCommandLog(incoming(), commandId)
        && (
          (incoming().executorRole == 'owner' && isOwnerAdmin()) ||
          (incoming().executorRole == 'admin' && isTierAdmin())
        )
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(commandId) && isOwnerAdmin();
    }

    // Public Non-PII Studio Visit Metrics
    match /metrics/{metricId} {
      allow get: if isValidId(metricId) && metricId == 'site';
      allow list: if false;
      allow create: if isValidId(metricId)
        && metricId == 'site'
        && isValidSiteMetrics(incoming())
        && incoming().visits == 1
        && incoming().updatedAt == request.time;
      allow update: if isValidId(metricId)
        && metricId == 'site'
        && isValidSiteMetrics(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['visits', 'updatedAt'])
        && incoming().visits == existing().visits + 1
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Public Non-PII Verified Member, Discord-Style Rank & Staff Directory
    match /publicMembers/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId)
        && isValidPublicMember(incoming(), userId)
        && (
          (isOwner(userId) && (
            (isOwnerAdmin() && incoming().role == 'owner') ||
            (!isOwnerAdmin() && incoming().role == 'member' && incoming().membershipTier == 'free' && !('serverRank' in incoming()) && !('serverRoles' in incoming()))
          )) ||
          isOwnerAdmin()
        )
        && incoming().joinedAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidPublicMember(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().joinedAt == existing().joinedAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'xp', 'presenceStatus', 'updatedAt'])
          ) || (
            isOwnerAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'role', 'serverRank', 'serverRoles', 'membershipTier', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isOwnerAdmin();
    }

    // Bidirectional Friend Requests, Friendships & User Blocking
    match /friendships/{friendshipId} {
      allow get: if isValidId(friendshipId) && isVerified() && request.auth.uid in existing().users;
      allow list: if isVerified() && request.auth.uid in resource.data.users;
      allow create: if isValidId(friendshipId)
        && isVerified()
        && isValidFriendship(incoming(), friendshipId)
        && incoming().requesterUid == request.auth.uid
        && (
          (incoming().status == 'pending' && !('blockedBy' in incoming())) ||
          (incoming().status == 'blocked' && incoming().blockedBy == request.auth.uid)
        )
        && (
          friendshipId == incoming().requesterUid + '_' + incoming().recipientUid ||
          friendshipId == incoming().recipientUid + '_' + incoming().requesterUid
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/publicMembers/$(incoming().recipientUid));
      allow update: if isValidId(friendshipId)
        && isVerified()
        && isValidFriendship(incoming(), friendshipId)
        && incoming().id == existing().id
        && incoming().users == existing().users
        && incoming().requesterUid == existing().requesterUid
        && incoming().recipientUid == existing().recipientUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().status == 'pending'
            && request.auth.uid == existing().recipientUid
            && incoming().status in ['accepted', 'declined']
            && !('blockedBy' in incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) || (
            existing().status in ['pending', 'accepted']
            && request.auth.uid in existing().users
            && incoming().status == 'blocked'
            && incoming().blockedBy == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'blockedBy', 'updatedAt'])
          )
        );
      allow delete: if isValidId(friendshipId)
        && isVerified()
        && request.auth.uid in existing().users
        && (existing().status != 'blocked' || existing().blockedBy == request.auth.uid);
    }

    // Community Suggestions to Add Searched Players
    match /playerSuggestions/{suggestionId} {
      allow get: if isValidId(suggestionId);
      allow list: if true;
      allow create: if isValidId(suggestionId)
        && isVerified()
        && isValidPlayerSuggestion(incoming(), suggestionId)
        && incoming().suggestedBy == request.auth.uid
        && incoming().status == 'pending'
        && !('reviewedBy' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(suggestionId)
        && (isOwnerAdmin() || isTierAdmin())
        && isValidPlayerSuggestion(incoming(), suggestionId)
        && incoming().id == existing().id
        && incoming().ign == existing().ign
        && incoming().suggestedBy == existing().suggestedBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().reviewedBy == request.auth.uid
        && existing().status == 'pending'
        && incoming().status in ['approved', 'declined']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'updatedAt']);
      allow delete: if isValidId(suggestionId) && (isOwnerAdmin() || isTierAdmin() || (isVerified() && existing().suggestedBy == request.auth.uid));
    }
  }
}
