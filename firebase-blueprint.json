{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated SwxStudios member profile and progression summary.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 500
        },
        "xp": {
          "type": "number"
        },
        "isPremium": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "xp", "isPremium", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document containing the owner's email address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "ConnectedAccount": {
      "title": "ConnectedAccount",
      "description": "Linked external identity provider (Discord, GitHub, Google, Twitch, Microsoft).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "provider": {
          "type": "string",
          "enum": ["google", "discord", "github", "microsoft", "twitch"]
        },
        "providerUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 500
        },
        "profileUrl": {
          "type": "string",
          "maxLength": 500
        },
        "connectedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "provider", "providerUserId", "username", "connectedAt"]
    },
    "ResourcePackage": {
      "title": "ResourcePackage",
      "description": "Owner-published Minecraft plugin, archive, model, or server setup package.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "subtitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3000
        },
        "category": {
          "type": "string",
          "enum": ["plugins", "configs", "setups", "models", "maps", "skripts", "clients", "bots", "source"]
        },
        "downloads": {
          "type": "number"
        },
        "views": {
          "type": "number"
        },
        "rating": {
          "type": "number"
        },
        "ratingCount": {
          "type": "number"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "mcVersions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "fileSize": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "publishedAt": {
          "type": "string",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 40
        },
        "popular": {
          "type": "boolean"
        },
        "exclusive": {
          "type": "boolean"
        },
        "tier": {
          "type": "string",
          "enum": ["free", "paid", "premium", "ultimate"]
        },
        "priceLabel": {
          "type": "string",
          "maxLength": 24
        },
        "openSource": {
          "type": "boolean"
        },
        "drmFree": {
          "type": "boolean"
        },
        "unobfuscated": {
          "type": "boolean"
        },
        "aiMarketing": {
          "type": "boolean"
        },
        "aiProduct": {
          "type": "boolean"
        },
        "resourceType": {
          "type": "string",
          "maxLength": 40
        },
        "gameModes": {
          "type": "array"
        },
        "supportedSoftware": {
          "type": "array"
        },
        "supportedVersions": {
          "type": "array"
        },
        "supportedLanguages": {
          "type": "array"
        },
        "dependencies": {
          "type": "array"
        },
        "changelog": {
          "type": "array"
        },
        "demoVideoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "tags": {
          "type": "array"
        },
        "artwork": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "accentColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "features": {
          "type": "array"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "fileExtension": {
          "type": "string",
          "enum": ["jar", "zip", "rar", "7z", "gz", "tar"]
        },
        "downloadUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "subtitle",
        "description",
        "category",
        "downloads",
        "rating",
        "ratingCount",
        "version",
        "mcVersions",
        "fileSize",
        "author",
        "updatedAt",
        "popular",
        "exclusive",
        "tags",
        "artwork",
        "accentColor",
        "features",
        "fileName",
        "fileExtension",
        "downloadUrl",
        "createdBy",
        "createdAt"
      ]
    },
    "CommunityThread": {
      "title": "CommunityThread",
      "description": "Public SwxStudios community discussion thread.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "authorRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "topic": {
          "type": "string",
          "enum": ["Plugins Help", "Server Setups", "Showcase", "Requests"]
        },
        "body": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3000
        },
        "upvotes": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["authorId", "authorName", "authorRole", "title", "topic", "body", "upvotes", "createdAt", "updatedAt"]
    },
    "ThreadReply": {
      "title": "ThreadReply",
      "description": "Reply to a SwxStudios community thread.",
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "authorRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["threadId", "authorId", "authorName", "authorRole", "content", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Owner-controlled global studio announcement and community toggle settings.",
      "type": "object",
      "properties": {
        "announcementVisible": {
          "type": "boolean"
        },
        "announcementLabel": {
          "type": "string",
          "maxLength": 60
        },
        "announcementText": {
          "type": "string",
          "maxLength": 240
        },
        "communityEnabled": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["announcementVisible", "announcementLabel", "announcementText", "communityEnabled", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Owner-scoped SwxStudios user account state and XP."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII document storing user email."
    },
    "/users/{userId}/connections/{providerId}": {
      "schema": { "$ref": "#/entities/ConnectedAccount" },
      "description": "Connected external OAuth providers (Discord, GitHub, Google, Microsoft, Twitch) owned by userId."
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/ResourcePackage" },
      "description": "Owner-managed Minecraft plugins, maps, setups, and downloadable archives."
    },
    "/threads/{threadId}": {
      "schema": { "$ref": "#/entities/CommunityThread" },
      "description": "Publicly readable community threads created by verified members."
    },
    "/threads/{threadId}/replies/{replyId}": {
      "schema": { "$ref": "#/entities/ThreadReply" },
      "description": "Replies under a community thread."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Owner-configured global site settings document (site)."
    }
  }
}
